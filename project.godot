; Engine configuration file.
config_version=5

[application]

config/name="Terrorscape - versione digitale (uso personale)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icona.png"
boot_splash/bg_color=Color(0.04, 0.02, 0.02, 1)
boot_splash/image="res://assets/varie/avvio.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=2
